APP_NAME=Spikia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_TIMEZONE=America/Bogota

LOG_CHANNEL=daily
LOG_LEVEL=info

# --- CORREO (SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Contraseña de aplicación sin espacios
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- BASE DE DATOS ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=Spikia
DB_USERNAME=root
DB_PASSWORD=

# --- TWILIO (SMS, opcional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- AVATAR 3D EN LENGUA DE SEÑAS (modulo opcional) ---
ENABLE_SIGN_AVATAR=true

# --- BOT DE REUNION (Meet/Zoom) - modulo opcional, requiere el worker en /meet-bot ---
ENABLE_MEETING_BOT=true
SPIKIA_MEETBOT_URL=http://127.0.0.1:4200
SPIKIA_MEETBOT_SECRET=

# --- LIVEKIT (video en tiempo real para el interprete en vivo) - cuenta gratis en cloud.livekit.io ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- BROADCAST / PUSHER / SOCKETS ---
BROADCAST_CONNECTION="null"
QUEUE_CONNECTION=sync
SPIKIA_SOCKET_ENABLED=true

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=us2

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- SESIONES Y CACHE ---
CACHE_STORE=file
CACHE_DRIVER=file
FILESYSTEM_DISK=local
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- DEEPL (fallback de traducción, opcional) ---
DEEPL_KEY=
DEEPL_ENDPOINT=

# --- OPENAI (STT + traducción + TTS) ---
OPENAI_API_KEY=

# --- DEEPGRAM (STT streaming continuo) ---
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
SPIKIA_MASTER_BASE_URL=http://127.0.0.1:8001
SPIKIA_PUBLIC_BASE_URL=

# --- ELEVENLABS (voz humana) ---
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_VOICE_ID_MALE=
ELEVENLABS_VOICE_ID_MARIN=
ELEVENLABS_VOICE_ID_CORAL=
ELEVENLABS_VOICE_ID_SHIMMER=
ELEVENLABS_VOICE_ID_CEDAR=
ELEVENLABS_VOICE_ID_ALLOY=
ELEVENLABS_VOICE_ID_SAGE=
ELEVENLABS_STABILITY=0.3
ELEVENLABS_SIMILARITY_BOOST=0.5

# Proveedor de voz por defecto para traducción simultánea: elevenlabs | openai
SPIKIA_VOICE_PROVIDER=elevenlabs