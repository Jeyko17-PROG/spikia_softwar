# Copiar a ".env" en esta misma carpeta y completar. NUNCA commitear el ".env" real.

# Puerto donde escucha tanto el HTTP (ingesta de secuencias desde Laravel) como el
# WebSocket (conexion con Unreal Engine, en el path /unreal del mismo puerto).
HTTP_PORT=4100

# Debe coincidir EXACTO con SIGN_ORCHESTRATOR_INTERNAL_TOKEN del .env de Laravel. Vacio =
# no se exige token (comodo en desarrollo local, NO recomendado en produccion).
INTERNAL_SERVICE_TOKEN=

# Token que el plugin de C++ de Unreal Engine debe mandar al registrarse por WebSocket. Debe
# coincidir con el valor compilado/configurado en el proyecto de Unreal (ver
# SpikiaSignWebSocketClient.h -> AuthToken). Vacio = no se exige (desarrollo local).
UNREAL_AUTH_TOKEN=

# Margen (ms) que se suma a la duracion de cada seña antes de mandar la siguiente.
FRAME_GAP_PADDING_MS=80

# Tope de frames guardados en buffer por sesion mientras Unreal Engine no esta conectado.
MAX_BUFFERED_FRAMES_PER_SESSION=500

LOG_LEVEL=info
