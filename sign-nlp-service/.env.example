# Copiar este archivo a ".env" en esta misma carpeta y completar los valores reales.
# NUNCA commitear el archivo ".env" real (ya deberia estar en .gitignore).

# --- OpenAI (obligatorio) ---
# Misma clave que usa el resto de Spikia para OpenAI (traduccion, transcripcion), o una clave
# separada si se quiere aislar el consumo/costos de este modulo.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=20

# --- Servidor ---
HOST=0.0.0.0
PORT=8100

# --- Seguridad interna (opcional en desarrollo) ---
# Si se completa, el endpoint /translate-to-sign exige este valor exacto en el header
# "X-Internal-Token" en cada request. Debe coincidir con SIGN_NLP_INTERNAL_TOKEN del .env de
# Laravel (ver ProcessSignGlossesJob). Dejar vacio en desarrollo local.
INTERNAL_SERVICE_TOKEN=

# --- Duraciones default (segundos) ---
DEFAULT_GLOSS_DURATION_SECONDS=0.9
FINGERSPELLING_LETTER_DURATION_SECONDS=0.35
